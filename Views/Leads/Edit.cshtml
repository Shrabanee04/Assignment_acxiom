@model Lead
@{ViewData["Title"] = ViewContext.RouteData.Values["action"]?.ToString() + " lead";}
<h1 class="page-title mb-4">@ViewData["Title"]</h1><div class="card p-4"><form asp-action="@ViewContext.RouteData.Values["action"]" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="LeadId"/><input type="hidden" asp-for="CreatedDate"/><div class="row g-3">
<div class="col-md-4"><label asp-for="LeadCode" class="form-label"></label><input asp-for="LeadCode" class="form-control"/><span asp-validation-for="LeadCode" class="text-danger"></span></div>
<div class="col-md-8"><label asp-for="LeadName" class="form-label"></label><input asp-for="LeadName" class="form-control"/><span asp-validation-for="LeadName" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control"/><span asp-validation-for="Phone" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control"/></div><div class="col-md-6"><label asp-for="Source" class="form-label"></label><select asp-for="Source" class="form-select"><option>Website</option><option>Referral</option><option>Campaign</option><option>Cold Call</option><option>Social Media</option></select></div>
<div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>New</option><option>Contacted</option><option>Qualified</option><option>Unqualified</option><option>Converted</option><option>Lost</option></select></div>
<div class="col-md-4"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select"><option>Low</option><option>Medium</option><option>High</option></select></div><div class="col-md-4"><label asp-for="ExpectedValue" class="form-label"></label><input asp-for="ExpectedValue" class="form-control"/><span asp-validation-for="ExpectedValue" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AssignedTo" class="form-label"></label><input asp-for="AssignedTo" class="form-control"/></div></div><div class="mt-4"><button class="btn btn-primary">Save lead</button> <a asp-action="Index" class="btn btn-light">Cancel</a></div></form></div>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
