@model IEnumerable<AuditLog>
@{ViewData["Title"]="Audit log";}
<h1 class="page-title mb-1">Audit log</h1><p class="muted mb-4">Recent security and business events. Restricted to Admin.</p>
<div class="card p-3"><form method="get" class="row g-2 mb-3"><div class="col-md-5"><input class="form-control" name="module" value="@ViewBag.Module" placeholder="Filter module/entity"/></div><div class="col-md-5"><input class="form-control" name="actionName" value="@ViewBag.ActionName" placeholder="Filter action"/></div><div class="col-md-2"><button class="btn btn-dark w-100">Filter</button></div></form><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Timestamp</th><th>User ID</th><th>Action</th><th>Entity</th><th>Record</th><th>Details</th><th>IP address</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CreatedDate.ToLocalTime().ToString("g")</td><td class="small">@x.UserId</td><td><span class="badge text-bg-light">@x.Action</span></td><td>@x.EntityName</td><td>@x.RecordId</td><td>@x.OldValue → @x.NewValue</td><td>@x.IpAddress</td></tr>}</tbody></table></div></div>
