@{ ViewData["Title"]="Dashboard"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="text-primary fw-semibold small text-uppercase">Overview</div><h1 class="page-title">Sales dashboard</h1><p class="muted mb-0">Your CRM activity at a glance.</p></div><span class="badge text-bg-light p-3">Role: @(User.IsInRole("Admin")?"Admin":User.IsInRole("Manager")?"Manager":"Sales Executive")</span></div>
<div class="row g-3 mb-4">
@foreach(var item in new[]{("Customers",ViewBag.Customers,"bi-people"),("Leads",ViewBag.Leads,"bi-person-lines-fill"),("Open opportunities",ViewBag.OpenOpportunities,"bi-briefcase"),("Won deals",ViewBag.Won,"bi-trophy"),("Lost deals",ViewBag.Lost,"bi-graph-down"),("Pipeline value","₹"+(((decimal)ViewBag.Pipeline).ToString("N0")),"bi-currency-rupee")}) {
<div class="col-6 col-md-4 col-xl-2"><div class="card p-3 h-100"><div class="muted small">@item.Item1</div><div class="stat">@item.Item2</div><div class="text-primary small mt-2">● Live records</div></div></div>
}
</div>
<div class="row g-4"><div class="col-lg-6"><div class="card p-4"><h5 class="fw-bold">Lead status</h5><canvas id="leadChart" height="220"></canvas></div></div><div class="col-lg-6"><div class="card p-4"><h5 class="fw-bold">Opportunity pipeline</h5><canvas id="oppChart" height="220"></canvas></div></div></div>
<div class="row g-3 mt-2"><div class="col-md-3"><a class="btn btn-primary w-100 py-3" asp-controller="Customers" asp-action="Create">＋ Add customer</a></div><div class="col-md-3"><a class="btn btn-outline-primary w-100 py-3" asp-controller="Leads" asp-action="Create">＋ Add lead</a></div><div class="col-md-3"><a class="btn btn-outline-primary w-100 py-3" asp-controller="Opportunities" asp-action="Create">＋ Add opportunity</a></div><div class="col-md-3"><a class="btn btn-outline-primary w-100 py-3" asp-controller="FollowUps" asp-action="Create">＋ Schedule follow-up</a></div></div>
@section Scripts {<script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>
const leads=@Html.Raw(ViewBag.LeadLabels); const opps=@Html.Raw(ViewBag.OpportunityLabels);
new Chart(document.getElementById('leadChart'),{type:'doughnut',data:{labels:leads.map(x=>x.label),datasets:[{data:leads.map(x=>x.count)}]},options:{responsive:true,plugins:{legend:{position:'bottom'}}}});
new Chart(document.getElementById('oppChart'),{type:'bar',data:{labels:opps.map(x=>x.label),datasets:[{label:'Opportunities',data:opps.map(x=>x.count)}]},options:{responsive:true,plugins:{legend:{display:false}}}});
</script>}
