<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] - AcxiomCRM</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
:root{--navy:#16324f;--blue:#2563eb;--bg:#f4f7fb}body{background:var(--bg);font-family:Inter,Segoe UI,sans-serif;color:#172b4d}
.navbar{background:var(--navy)}.navbar-brand{font-weight:800;letter-spacing:.4px}.card{border:0;border-radius:16px;box-shadow:0 6px 24px #172b4d0d}.btn-primary{background:var(--blue);border-color:var(--blue)}.page-title{font-weight:800}.table{vertical-align:middle}.form-control,.form-select{border-radius:10px;padding:.65rem}.stat{font-size:1.8rem;font-weight:800}.muted{color:#718096}
</style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark mb-4"><div class="container-fluid px-lg-5">
<a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">ACXIOM<span class="text-info">CRM</span></a>
<button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto">
@if(User.Identity?.IsAuthenticated==true){
<li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Leads" asp-action="Index">Leads</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index">Opportunities</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="FollowUps" asp-action="Index">Follow-ups</a></li>
@if(User.IsInRole("Admin")){<li class="nav-item"><a class="nav-link" asp-controller="Audit" asp-action="Index">Audit Log</a></li>}
}</ul>
<div class="d-flex align-items-center gap-3 text-white">
@if(User.Identity?.IsAuthenticated==true){<span class="small">@User.Identity.Name</span><form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/"><button class="btn btn-outline-light btn-sm">Logout</button></form>}
else{<a class="btn btn-outline-light btn-sm" asp-area="Identity" asp-page="/Account/Login">Login</a><a class="btn btn-info btn-sm" asp-area="Identity" asp-page="/Account/Register">Register</a>}
</div></div></div></nav>
<main class="container-fluid px-lg-5 pb-5">
@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}
@RenderBody()
</main>
<footer class="text-center small muted py-4">AcxiomCRM · Customer relationships, made clearer.</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required:false)
</body></html>
