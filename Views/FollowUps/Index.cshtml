@model IEnumerable<FollowUp>
@{ViewData["Title"]="Follow-ups";}
<div class="d-flex justify-content-between mb-4"><div><h1 class="page-title">Follow-ups</h1><p class="muted">Stay on top of planned customer touchpoints.</p></div><a class="btn btn-primary align-self-start" asp-action="Create">＋ Schedule follow-up</a></div>
<div class="card p-3"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Date</th><th>Type</th><th>Customer ID</th><th>Lead ID</th><th>Remarks</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.FollowUpDate.ToString("d")</td><td>@x.FollowUpType</td><td>@x.CustomerId</td><td>@x.LeadId</td><td>@x.Remarks</td><td><span class="badge text-bg-info">@x.Status</span></td><td>@if(x.Status=="Planned"){<form asp-action="Complete" method="post"><input type="hidden" name="id" value="@x.FollowUpId"/><button class="btn btn-sm btn-outline-success">Complete</button></form>}</td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="text-center muted py-4">No follow-ups yet.</td></tr>}</tbody></table></div></div>
