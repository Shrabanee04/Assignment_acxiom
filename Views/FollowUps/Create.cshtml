@model FollowUp
@{ViewData["Title"]="Schedule follow-up";}
<h1 class="page-title mb-4">Schedule follow-up</h1><div class="card p-4"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="FollowUpDate" class="form-label"></label><input asp-for="FollowUpDate" type="date" class="form-control"/><span asp-validation-for="FollowUpDate" class="text-danger"></span></div><div class="col-md-6"><label asp-for="FollowUpType" class="form-label"></label><select asp-for="FollowUpType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div><div class="col-md-6"><label asp-for="CustomerId" class="form-label">Customer ID (optional)</label><input asp-for="CustomerId" class="form-control"/></div><div class="col-md-6"><label asp-for="LeadId" class="form-label">Lead ID (optional)</label><input asp-for="LeadId" class="form-control"/></div><div class="col-md-6"><label asp-for="AssignedTo" class="form-label"></label><input asp-for="AssignedTo" class="form-control"/></div><div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Planned</option><option>Cancelled</option></select></div><div class="col-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="3"></textarea></div></div><div class="mt-4"><button class="btn btn-primary">Save follow-up</button> <a asp-action="Index" class="btn btn-light">Cancel</a></div></form></div>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
