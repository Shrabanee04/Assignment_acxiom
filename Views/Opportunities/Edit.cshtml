@model Opportunity
@{ViewData["Title"] = ViewContext.RouteData.Values["action"]?.ToString() + " opportunity";}
<h1 class="page-title mb-4">@ViewData["Title"]</h1><div class="card p-4"><form asp-action="@ViewContext.RouteData.Values["action"]" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="OpportunityId"/><input type="hidden" asp-for="CreatedDate"/><div class="row g-3">
<div class="col-md-8"><label asp-for="OpportunityName" class="form-label"></label><input asp-for="OpportunityName" class="form-control"/><span asp-validation-for="OpportunityName" class="text-danger"></span></div><div class="col-md-4"><label asp-for="CustomerId" class="form-label">Customer ID (optional)</label><input asp-for="CustomerId" class="form-control"/></div>
<div class="col-md-4"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control"/><span asp-validation-for="Amount" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control"/><span asp-validation-for="Probability" class="text-danger"></span></div><div class="col-md-4"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" type="date" class="form-control"/><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div><div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Open</option><option>Closed</option></select></div><div class="col-md-6"><label asp-for="AssignedTo" class="form-label"></label><input asp-for="AssignedTo" class="form-control"/></div></div><div class="mt-4"><button class="btn btn-primary">Save opportunity</button> <a asp-action="Index" class="btn btn-light">Cancel</a></div></form></div>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
