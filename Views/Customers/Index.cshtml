@model IEnumerable<Customer>
@{ViewData["Title"]="Customers";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="page-title">Customers</h1><p class="muted mb-0">Manage your customer directory.</p></div><a class="btn btn-primary" asp-action="Create">＋ New customer</a></div>
<div class="card p-3"><form method="get" class="row g-2 mb-3"><div class="col-md-10"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Search name, email, phone or company..." /></div><div class="col-md-2"><button class="btn btn-dark w-100">Search</button></div></form>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Code</th><th>Customer</th><th>Company</th><th>Contact</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach(var c in Model){<tr><td><span class="badge text-bg-light">@c.CustomerCode</span></td><td><strong>@c.CustomerName</strong><div class="small muted">@c.City, @c.State</div></td><td>@c.CompanyName</td><td>@c.Email<div class="small muted">@c.Phone</div></td><td><span class="badge @(c.Status=="Active"?"text-bg-success":"text-bg-secondary")">@c.Status</span></td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@c.CustomerId">View</a> · <a asp-action="Edit" asp-route-id="@c.CustomerId">Edit</a> · <a class="text-danger" asp-action="Delete" asp-route-id="@c.CustomerId">Delete</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="6" class="text-center muted py-4">No customers yet. Add your first customer.</td></tr>}
</tbody></table></div></div>
