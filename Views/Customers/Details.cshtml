@model Customer
@{ViewData["Title"]="Customer details";}
<div class="card p-4"><h1 class="page-title">@Model.CustomerName</h1><p class="muted">@Model.CustomerCode · @Model.Status</p><dl class="row"><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd><dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Address, @Model.City, @Model.State</dd><dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedDate.ToLocalTime()</dd></dl><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.CustomerId">Edit</a> <a class="btn btn-light" asp-action="Index">Back</a></div>
