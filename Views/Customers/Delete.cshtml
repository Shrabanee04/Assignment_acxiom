@model Customer
@{ViewData["Title"]="Delete customer";}
<div class="card p-4"><h1 class="text-danger">Delete customer?</h1><p>You're about to permanently delete <strong>@Model.CustomerName</strong> (@Model.Email).</p><form asp-action="Delete" method="post"><input type="hidden" asp-for="CustomerId"/><button class="btn btn-danger">Confirm delete</button> <a asp-action="Index" class="btn btn-light">Cancel</a></form></div>
